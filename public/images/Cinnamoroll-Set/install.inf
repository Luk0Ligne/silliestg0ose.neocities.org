[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 25,Cursors

[Scheme.Cur]
cinnamoroll person (2).cur
cinnamoroll person.cur
cinnamoroll working in background.cur
cinnamoroll precision.cur
cinnamoroll alternate select.cur
cinnamoroll unvailable.cur
cinnamoroll help select.cur
cinnamoroll link.cur
cinnamoroll move.cur
cinnamoroll text.cur
cinnamoroll vertical.cur
cinnamoroll horizontal.cur
cinnamoroll diagonal.cur
cinnamoroll pointer.cur
cinnamoroll diagonal 2.cur
cinnamoroll busy.cur

[Scheme.Reg]
HKCU,"Control Panel\Cursors","Pin",,"%25%\Cursors\cinnamoroll person (2).cur"
HKCU,"Control Panel\Cursors","Person",,"%25%\Cursors\cinnamoroll person.cur"
HKCU,"Control Panel\Cursors","AppStarting",,"%25%\Cursors\cinnamoroll working in background.cur"
HKCU,"Control Panel\Cursors","Cross",,"%25%\Cursors\cinnamoroll precision.cur"
HKCU,"Control Panel\Cursors","UpArrow",,"%25%\Cursors\cinnamoroll alternate select.cur"
HKCU,"Control Panel\Cursors","No",,"%25%\Cursors\cinnamoroll unvailable.cur"
HKCU,"Control Panel\Cursors","Help",,"%25%\Cursors\cinnamoroll help select.cur"
HKCU,"Control Panel\Cursors","Hand",,"%25%\Cursors\cinnamoroll link.cur"
HKCU,"Control Panel\Cursors","SizeAll",,"%25%\Cursors\cinnamoroll move.cur"
HKCU,"Control Panel\Cursors","IBeam",,"%25%\Cursors\cinnamoroll text.cur"
HKCU,"Control Panel\Cursors","SizeNS",,"%25%\Cursors\cinnamoroll vertical.cur"
HKCU,"Control Panel\Cursors","SizeWE",,"%25%\Cursors\cinnamoroll horizontal.cur"
HKCU,"Control Panel\Cursors","SizeNWSE",,"%25%\Cursors\cinnamoroll diagonal.cur"
HKCU,"Control Panel\Cursors","Arrow",,"%25%\Cursors\cinnamoroll pointer.cur"
HKCU,"Control Panel\Cursors","SizeNESW",,"%25%\Cursors\cinnamoroll diagonal 2.cur"
HKCU,"Control Panel\Cursors","Wait",,"%25%\Cursors\cinnamoroll busy.cur"
; Set scheme name
HKCU,"Control Panel\Cursors","(Default)",,"Cinnamoroll Set"
HKCU,"Control Panel\Cursors\Schemes","Cinnamoroll Set",,""